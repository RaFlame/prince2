# Copy to .env.local and fill in from Supabase → Project Settings → API
# Use the same values in Vercel → Settings → Environment Variables.
# Auth: create users in Supabase Dashboard (no public signup). See docs/AUTH.md.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: official MarineTraffic AIS API (paid). Without it, voyage refresh
# uses open AIS (Open Waters / BarentsWatch) for THERNEY ETA + last report.
# MARINETRAFFIC_API_KEY=
